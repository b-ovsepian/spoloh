[Unit]
Description=Spoloh air raid alert announcer
After=network-online.target sound.target NetworkManager.service
Wants=network-online.target NetworkManager.service
# NetworkManager is what lets this unit raise its own access point when the
# board has no upstream network (internal/netmgr.Supervisor); it is not what
# lets it announce alerts. Wants + After only order and prefer it, they do
# not require it, and that is deliberate: a board with no NetworkManager
# installed still has to boot and keep sounding alerts, degraded and unable
# to raise an access point (see internal/netmgr.Supervisor's doc comment and
# cmd/spoloh/main.go). Do not change this to Requires= — that would turn a
# missing optional package into a reason a life-safety device refuses to
# start.
# Spec §10: the device never stops trying. systemd's default start rate limit
# (5 starts in 10s) would otherwise put the unit into a permanent failed state
# after a crash loop — a silent announcer that no longer even tries to come
# back, which is the worst failure this device can have. 0 disables the limit;
# RestartSec=5 below is what keeps the retries from becoming a busy loop.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=60
# The spoloh user must exist before this unit starts. Install it with
# deploy/spoloh.sysusers (see that file's header for the exact command);
# ProtectHome/ProtectSystem below give it no other way onto the box.
User=spoloh
# Group= is the socket's group, and the socket's group is the CLI's
# authorisation: /run/spoloh/control.sock is created 0660 owned by this
# User=/Group= pair, so "may run `spoloh status`" means "is in this group"
# and nothing else. That has to be a group that exists for this purpose, not
# one that already means something else on the board — with Group=audio,
# adding an operator to the group that lets them use the CLI would also hand
# them every sound card on the device.
#
# The audio access the daemon itself needs (aplay, amixer) is a supplementary
# group instead. Group membership is group membership: nothing about ALSA
# cares which of the two it arrives through. deploy/spoloh.sysusers already
# puts the spoloh user in audio; naming it here as well means the unit does
# not depend on that having been read correctly.
Group=spoloh
SupplementaryGroups=audio
# No -listen flag: the dashboard binds its default of :80. The address is a
# flag rather than a config.json field on purpose (see cmd/spoloh/main.go),
# so recovering an unreachable dashboard never needs more than editing this
# unit — never an SD card reader.
ExecStart=/usr/local/bin/spoloh -config /etc/spoloh/config.json -data /var/lib/spoloh
Restart=always
RestartSec=5
# Port 80 without running as root, so http://spoloh.local needs no port suffix.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
# StateDirectory is created AND chowned to User=/Group= by systemd before
# ExecStart runs, so /var/lib/spoloh needs nothing else.
StateDirectory=spoloh
# ConfigurationDirectory= looked like the /etc equivalent of StateDirectory
# but is not: systemd.exec(5) creates it root-owned regardless of User=/
# Group= (mode ConfigurationDirectoryMode=, default 0755), so the spoloh
# process could read it but not write the config it seeds on first boot.
# /etc/spoloh must therefore already exist, owned by spoloh, before this
# unit starts: see deploy/spoloh.tmpfiles. ReadWritePaths=- (the leading
# "-" tolerates the path not existing when the unit is started, unlike a
# bare ReadWritePaths=, which fails the start) then grants the write
# exception ProtectSystem=full
# would otherwise deny for a directory outside StateDirectory/RuntimeDirectory.
ReadWritePaths=-/etc/spoloh
# /run/spoloh, where the daemon publishes its control socket. systemd creates
# it owned by User=/Group= before ExecStart and removes it when the unit
# stops, which deploy/spoloh.tmpfiles could not do as cleanly: tmpfiles
# declares a directory that then persists, so a socket left by an unclean
# shutdown would survive to be inherited by the next start. Here there is
# normally nothing to inherit. 0750 so only the spoloh group can traverse
# into it — the socket's own 0660 is the gate, and this is the lock on the
# door in front of it.
RuntimeDirectory=spoloh
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
