[Unit]
Description=Spoloh air raid alert announcer
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=spoloh
Group=audio
ExecStart=/usr/local/bin/spoloh -config /etc/spoloh/config.json -data /var/lib/spoloh
Restart=always
RestartSec=5
# Port 80 without running as root, so http://spoloh.local needs no port suffix.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/spoloh /etc/spoloh

[Install]
WantedBy=multi-user.target
