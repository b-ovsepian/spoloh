[Unit]
Description=Spoloh air raid alert announcer
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
# The spoloh user must exist before this unit starts. Install it with
# deploy/spoloh.sysusers (see that file's header for the exact command);
# ProtectHome/ProtectSystem below give it no other way onto the box.
User=spoloh
Group=audio
ExecStart=/usr/local/bin/spoloh -config /etc/spoloh/config.json -data /var/lib/spoloh
Restart=always
RestartSec=5
# Port 80 without running as root, so http://spoloh.local needs no port suffix.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
# StateDirectory/ConfigurationDirectory (unlike ReadWritePaths) are created
# and chowned to User=/Group= by systemd before ExecStart runs, and they grant
# the write exception ReadWritePaths cannot: ProtectSystem=full makes /etc
# read-only, so main.go's first-boot MkdirAll("/etc/spoloh") only works
# because systemd already created that directory for us.
StateDirectory=spoloh
ConfigurationDirectory=spoloh

[Install]
WantedBy=multi-user.target
